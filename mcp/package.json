{
  "name": "webnp2-mcp",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "MCP server that operates the WebNP2 (PC-98 emulator) running in a browser via a WebSocket bridge",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "bundle": "esbuild server.mjs --bundle --platform=node --format=esm --target=node24 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __webnp2CreateRequire}from'node:module';const require=__webnp2CreateRequire(import.meta.url);\" --outfile=dist/webnp2-mcp.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2"
  }
}

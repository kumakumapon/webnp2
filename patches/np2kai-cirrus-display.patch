diff --git a/sdl/scrnmng.c b/sdl/scrnmng.c
index 2e5016f..41feb23 100755
--- a/sdl/scrnmng.c
+++ b/sdl/scrnmng.c
@@ -692,6 +692,12 @@ scrnmng_update(void)
 
 // fullscreen resolution
 void scrnmng_updatefsres(void) {
+#if defined(__EMSCRIPTEN__) && defined(SUPPORT_WAB)
+    if ((np2wab.relay & 3) && np2wab.wndWidth >= 32 && np2wab.wndHeight >= 32) {
+        if (scrnmng.width != np2wab.wndWidth) scrnmng_setwidth(0, np2wab.wndWidth);
+        if (scrnmng.height != np2wab.wndHeight) scrnmng_setheight(0, np2wab.wndHeight);
+    }
+#endif
 }
 
 // transmit WAB display
@@ -700,6 +706,12 @@ void scrnmng_blthdc(void) {
 
 void scrnmng_bltwab(void) {
 #if defined(SUPPORT_WAB)
+#if defined(__EMSCRIPTEN__)
+    if (np2wab.realWidth < 32 || np2wab.realHeight < 32 ||
+        np2wab.realWidth > WAB_MAX_WIDTH || np2wab.realHeight > WAB_MAX_HEIGHT) return;
+    if (scrnmng.width != np2wab.realWidth) scrnmng_setwidth(0, np2wab.realWidth);
+    if (scrnmng.height != np2wab.realHeight) scrnmng_setheight(0, np2wab.realHeight);
+#endif
 	if(scrnmng.pc98surf) {
 #if !defined(__LIBRETRO__)
 		SDL_LockSurface(scrnmng.pc98surf);
@@ -720,3 +732,14 @@ void scrnmng_bltwab(void) {
 	}
 #endif
 }
+
+#if defined(__EMSCRIPTEN__) && defined(SUPPORT_WAB)
+/* Actual frontend/device state for graphics-mode verification. */
+EMSCRIPTEN_KEEPALIVE UINT32 *webnp2_graphics_info(void) {
+    static UINT32 info[8];
+    info[0]=scrnmng.width;info[1]=scrnmng.height;info[2]=scrnmng.bpp;
+    info[3]=draw32bit;info[4]=np2cfg.usegd5430;info[5]=np2wab.relay;
+    info[6]=np2wab.realWidth;info[7]=np2wab.realHeight;
+    return info;
+}
+#endif

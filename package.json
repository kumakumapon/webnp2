{
  "name": "webnp2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:embed": "npm --prefix packages/embed run build",
    "preview": "vite preview",
    "test": "vitest run",
    "capture-help": "node scripts/capture-help-shots.mjs",
    "lint": "eslint .",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "test:tools": "node --test scripts/ci/*.test.mjs && python3 -m unittest discover -s scripts -p test_*.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "playwright": "^1.64.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
